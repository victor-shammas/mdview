// App identity and version, shared by Plainview.xcodeproj and install.sh
// (install.sh reads these simple `KEY = value` lines).
PRODUCT_NAME = Plainview
PRODUCT_BUNDLE_IDENTIFIER = com.victorshammas.plainview
MARKETING_VERSION = 2.0.0
// Must increase with every App Store Connect upload.
CURRENT_PROJECT_VERSION = 2
MACOSX_DEPLOYMENT_TARGET = 14.0

// Signing. Xcode manages certificates and profiles for this team. The Team ID
// is not a secret; certificates and keys never go in this repo.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = JPP8RN6BJB
