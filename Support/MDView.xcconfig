// App identity and version, shared by MDView.xcodeproj and install.sh
// (install.sh reads these simple `KEY = value` lines).
PRODUCT_NAME = MDView
PRODUCT_BUNDLE_IDENTIFIER = com.victorshammas.mdview
MARKETING_VERSION = 1.1.1
// Must increase with every App Store Connect upload.
CURRENT_PROJECT_VERSION = 1
MACOSX_DEPLOYMENT_TARGET = 12.0

// Signing. Until there is an Apple Developer team, builds are signed to run
// locally only. Then set DEVELOPMENT_TEAM to the Team ID (not a secret) and
// delete the CODE_SIGN_IDENTITY line so Xcode manages certificates.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -
